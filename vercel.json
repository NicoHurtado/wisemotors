{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "devCommand": "next dev",
  "regions": [
    "iad1"
  ],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    },
    "app/api/admin/ingest/route.ts": {
      "maxDuration": 300
    },
    "app/api/compare/ia/route.ts": {
      "maxDuration": 120
    },
    "app/api/admin/ingest/foto/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/ingest/publish/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/vehicles/*/complementar/route.ts": {
      "maxDuration": 120
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
