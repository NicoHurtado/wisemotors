# Copia este archivo a .env.local y llena los valores.
# .env.local tiene prioridad sobre .env en Next.js.

# ── Base de datos (Neon / PostgreSQL) ────────────────────────────────────────
# Mismos nombres que crea la integración Neon de Vercel con el prefijo WISE.
# La de pooler es para la app; la UNPOOLED (directa) para crear/alterar tablas.
WISE_DATABASE_URL=
WISE_DATABASE_URL_UNPOOLED=

# ── Autenticación ────────────────────────────────────────────────────────────
# OBLIGATORIO. Sin esta variable la app lanza error en la primera operación de
# auth: ya no existe el fallback 'your-secret-key' que permitía a cualquiera
# firmar tokens válidos.
# Generar con:  openssl rand -base64 48
JWT_SECRET=

# ── Cuenta admin inicial (solo la usa el deploy de producción) ───────────────
# Si el correo no existe en la base, el deploy lo crea con rol admin. Nunca
# asciende una cuenta existente ni cambia contraseñas (scripts/preparar-bd.ts).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Claude (Anthropic) — ingesta con IA ─────────────────────────────────────
ANTHROPIC_API_KEY=
# Solo si la clave no está atada a un workspace (Console → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=

# ── Cloudinary (subida de imágenes) ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcional: mapa oficial de Google en los concesionarios (Maps Embed API, gratis y
# sin límite de uso). Sin ella se usa el embed clásico sin clave. Restringe la
# clave a la Maps Embed API y a tu dominio en Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
