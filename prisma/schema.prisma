generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  username  String     @map("name")
  role      String     @default("user") // user, admin
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relaciones
  favorites Favorite[]

  @@map("users")
}

model Dealer {
  id             String          @id @default(cuid())
  name           String
  location       String
  address        String
  phone          String
  email          String
  status         String          @default("Activo")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  vehicleDealers VehicleDealer[]
  vehicles       Vehicle[]       @relation("DealerVehicles")
  whatsappLeads  WhatsAppLead[]

  @@map("dealers")
}

model Vehicle {
  id             String          @id @default(cuid())
  brand          String
  model          String
  year           Int
  price          Float
  type           String
  vehicleType    String
  fuelType       String
  history        String?
  wiseCategories String?
  specifications String
  reviewVideoUrl String?
  status         String          @default("Disponible")
  isTrending     Boolean         @default(false)
  trendingOrder  Int?
  // Cobertura de datos (se recalcula al migrar/ingestar atributos)
  coverageGlobal    Float?
  coverageByDimension String?    // JSON: { "desempeño": 0.8, "seguridad": 0.6, ... }
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  favorites      Favorite[]
  vehicleDealers VehicleDealer[]
  images         VehicleImage[]
  dealers        Dealer[]        @relation("DealerVehicles")
  whatsappLeads  WhatsAppLead[]
  attributes     VehicleAttribute[]

  @@index([status, type, price])
  @@index([status, price])
  @@index([brand, model])
  @@map("vehicles")
}

// ============================================================================
// REGISTRO DE ATRIBUTOS — reemplaza progresivamente el JSON `specifications`.
// Agregar un campo = insertar una fila aquí. Nada de tocar 4 formularios.
// ============================================================================
model AttributeDefinition {
  key             String   @id // canónico y namespaced, ej. 'combustion.maxTorque'
  labelEs         String
  unit            String?
  dataType        String   // numeric | boolean | text | enum
  direction       String   @default("neutral") // higher_better | lower_better | neutral
  appliesTo       String   @default("*") // CSV de fuelTypes aplicables, o '*'
  displayGroup    String   // grupo visual en la ficha
  dimension       String   // dimensión de cobertura: desempeño, seguridad, confort...
  displayPriority Int      @default(50) // 0-100, qué tan arriba va
  cardEligible    Boolean  @default(false) // ¿puede salir en tarjeta de catálogo?
  coAvailability  String   @default("common") // common | rare | never_published
  comparable      Boolean  @default(true)
  expectedMin     Float?   // validación física para la ingesta
  expectedMax     Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  values          VehicleAttribute[]

  @@index([dimension])
  @@map("attribute_definitions")
}

// Un hecho observado sobre un vehículo, con fuente y confianza.
model VehicleAttribute {
  id           String   @id @default(cuid())
  vehicleId    String
  attributeKey String
  valueNum     Float?
  valueText    String?
  valueBool    Boolean?
  confidence   Float    @default(1.0) // 0-1
  sourceTier   Int      @default(1) // 1 fabricante CO, 2 prensa/global, 3 comunidad
  sourceUrl    String?
  extractedAt  DateTime @default(now())
  verifiedBy   String? // userId del auditor humano
  verifiedAt   DateTime?
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  definition   AttributeDefinition @relation(fields: [attributeKey], references: [key])

  @@unique([vehicleId, attributeKey])
  @@index([attributeKey, valueNum]) // por fin: filtrar por spec en SQL
  @@index([vehicleId])
  @@map("vehicle_attributes")
}

// Bandas de precio Colombia, con vigencia. Se recalibran cada semestre.
model PriceBand {
  id        String    @id @default(cuid())
  key       String // entrada | popular | media | media_alta | premium | lujo
  labelEs   String
  minPrice  Float // COP
  maxPrice  Float? // null = sin techo
  validFrom DateTime  @default(now())
  validTo   DateTime? // null = vigente

  @@index([validTo])
  @@map("price_bands")
}

// Percepción de marca calibrada a Colombia. Curada a mano — es criterio, no fórmula.
model BrandPerception {
  brand             String   @id
  prestige          Int // 0-100 percepción social CO
  reliability       Int // 0-100 confiabilidad percibida
  partsAvailability Int // 0-100 facilidad de repuestos CO
  notes             String?
  updatedAt         DateTime @updatedAt

  @@map("brand_perception_co")
}

model VehicleImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  type      String   @default("gallery")
  order     Int      @default(0)
  isThumbnail Boolean @default(false)
  vehicleId String
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_images")
}

model VehicleDealer {
  id          String   @id @default(cuid())
  vehicleId   String
  dealerId    String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  dealer      Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, dealerId])
  @@map("vehicle_dealers")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  vehicleId String
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, vehicleId], map: "favorites_user_vehicle_unique")
  @@map("favorites")
}

model WhatsAppLead {
  id           String    @id @default(cuid())
  name         String
  username     String?
  email        String?
  phone        String?
  vehicleId    String?
  vehicleBrand String?
  vehicleModel String?
  dealershipId String?
  dealershipName String?
  status       String    @default("Nuevo") // Nuevo, Contactado, Interesado, Vendido, Perdido
  message      String?   // Mensaje completo enviado por WhatsApp
  source       String    @default("website") // website, specific_dealership, home_delivery
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  vehicle      Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  dealership   Dealer?   @relation(fields: [dealershipId], references: [id], onDelete: SetNull)

  @@map("whatsapp_leads")
}
